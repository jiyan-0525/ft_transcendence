# Copy to .env and configure local credentials.
APP_NAME=community-api
APP_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence
DATABASE_URL=postgresql+psycopg://postgres:change_me@127.0.0.1:5432/transcendence

# Optional auth overrides. Required origin when serving a browser in production.
# AUTH_ALLOWED_ORIGIN=https://social.example.com
# AUTH_SESSION_HOURS=24

# Required only by make stack-up. Match the local database credentials; use host db.
# CONTAINER_DATABASE_URL=postgresql+psycopg://postgres:change_me@db:5432/transcendence
