# Frontend environment (Vite)
# Copy to .env.local for local overrides; .env.local is git-ignored.

# Same-origin by default: the Vite dev server proxies /api and /ws to :8000.
VITE_API_URL=/api
VITE_WS_URL=/ws

# Use the in-memory mock transport until the FastAPI auth endpoints are ready.
VITE_USE_MOCKS=true
